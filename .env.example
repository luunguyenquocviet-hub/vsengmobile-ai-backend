# ===== VsengMobile Hybrid AI Backend — cấu hình môi trường =====
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env!

# --- MongoDB (luồng hành vi user_tracking) ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# --- MySQL (products, reviews, users, orders) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=vsengmobile_store_db

# --- VNPay Sandbox (thanh toán) ---
# Đăng ký test: https://sandbox.vnpayment.vn/devreg
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8000/api/payment/vnpay/return
VNPAY_MOCK=1

# --- Chuyển khoản ngân hàng QR (VietQR + SePay webhook) ---
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
SEPAY_API_TOKEN=

# --- Gmail (gửi OTP quên mật khẩu) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
